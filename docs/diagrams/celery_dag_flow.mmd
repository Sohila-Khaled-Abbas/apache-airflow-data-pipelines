%% Celery DAG Flow & Multi-Queue Routing Diagram
%% Illustrates task dependencies and worker queue routing in infra/celery/dags/celery.py

graph TD
    classDef dag fill:#e8f0fe,stroke:#2c3e50,stroke-width:2px
    classDef cpuTask fill:#2e7d32,color:#ffffff,stroke:none
    classDef gpuTask fill:#1565c0,color:#ffffff,stroke:none
    classDef queueNode fill:#fff3e0,stroke:#ef6c00,stroke-width:1px

    subgraph DAG_celery["DAG: celery (CeleryExecutor)"]
        A["@task(queue='cpu')<br/>def a()"]:::cpuTask
        B["@task(queue='gpu')<br/>def b()"]:::gpuTask
        C["@task(queue='cpu')<br/>def c()"]:::cpuTask
        D["@task(queue='cpu')<br/>def d()"]:::cpuTask
    end

    A -->|"a() >> [b(), c(), d()]"| B
    A -->|"a() >> [b(), c(), d()]"| C
    A -->|"a() >> [b(), c(), d()]"| D

    Q_CPU[("Queue: cpu<br/>airflow-worker-2 (-q cpu)")]:::queueNode
    Q_GPU[("Queue: gpu<br/>airflow-worker (-q gpu)")]:::queueNode

    A -.-> Q_CPU
    C -.-> Q_CPU
    D -.-> Q_CPU
    B -.-> Q_GPU

    class DAG_celery dag
