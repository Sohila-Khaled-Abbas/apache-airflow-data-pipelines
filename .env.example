# Local Airflow Performance Tuning Template
# Copy this file to .env to customize local resource usage.
AIRFLOW__CORE__PARALLELISM=6
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=4
AIRFLOW__DAG_PROCESSOR__PARSING_PROCESSES=2
AIRFLOW__DAG_PROCESSOR__MIN_FILE_PROCESS_INTERVAL=30

# --- Celery executor (uncomment & copy into .env to enable Celery) ---
# AIRFLOW__CORE__EXECUTOR=CeleryExecutor
# AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
# AIRFLOW__CELERY__RESULT_BACKEND=redis://redis:6379/0
# AIRFLOW__CELERY__WORKER_CONCURRENCY=6
# AIRFLOW__CELERY__WORKER_PREFETCH_MULTIPLIER=1
# AIRFLOW__CELERY__TASK_ACKS_LATE=True
# AIRFLOW__CELERY__WORKER_MAX_TASKS_PER_CHILD=200

# --- Metadata database ---
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# --- DAG folder / parsing ---
# AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
# AIRFLOW__CORE__LOAD_EXAMPLES=False
# PYTHONPATH=/opt/airflow
