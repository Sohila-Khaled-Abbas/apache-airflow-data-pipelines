# CeleryExecutor Environment Configuration
# Copy this file to .env and adjust values as needed.

# Airflow Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Redis
# Redis 7.2+ uses dual-source licensing; see https://redis.io/blog/redis-adopts-dual-source-available-licensing/

# Airflow Settings
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true

# Webserver
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW__WEBSERVER__WORKERS=2
AIRFLOW__WEBSERVER__WEB_SERVER_MASTER_TIMEOUT=300
AIRFLOW__WEBSERVER__WEB_SERVER_WORKER_TIMEOUT=300

# Parallelism & Concurrency (tuned for local 4-CPU / 6 GB Docker Desktop VM; raise on larger hosts)
AIRFLOW__CORE__PARALLELISM=8
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=4
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=60
AIRFLOW__CELERY__WORKER_CONCURRENCY=4
AIRFLOW__DAG_PROCESSOR__PARSING_PROCESSES=1
AIRFLOW__DAG_PROCESSOR__MIN_FILE_PROCESS_INTERVAL=30
AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=60

# Additional PIP requirements (installed at container startup)
_PIP_ADDITIONAL_REQUIREMENTS=
